# Godot's local cache (rebuilt automatically, never commit)
.godot/
*.tmp

# The Godot editor itself lives in this folder for convenience; don't commit it
Godot_*.exe
Godot_*.zip

# Exports / builds
build/

# OS junk
Thumbs.db
.DS_Store

# Animations Godot pulls out of the character FBX files on import
characters/**/anims/*.res

# Music stems straight from Suno (huge WAVs): kept on your computer only.
# tools/mix_song.sh turns them into the small layer files the game plays.
audio/stems/
