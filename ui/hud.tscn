text = "WASD / left stick - move
Hold Shift / RT - free-run (auto-parkour)
C, Ctrl / B - crouch (while running: slide)
  Jump during a slide - slide-jump
Jump next to a wall - wall jump
Sprint + jump alongside a tall wall - wall run
E / RB - toss a nearby friend (aim with camera)
Solo practice: G / D-pad down - call buddy
  Q / LB - buddy tosses you
Space / A - jump (hold = higher)
Jump into a wall - grab the ledge
  Space / A - climb up
  A, D / stick - shimmy along
  C, Ctrl / B - let go
Mouse / right stick / arrows - camera
R / Back - respawn
Esc / Start - pause menu
F1 - hide this help"
horizontal_alignment = 2

